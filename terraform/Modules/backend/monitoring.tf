# ---------------------------------------------------------------------------
# Monitoring: CloudWatch alarms + dashboard for the ALB and the ECS service.
# Alarms notify an SNS topic; e-mail delivery is only set up if var.alert_email is set.
# ---------------------------------------------------------------------------

data "aws_region" "current" {}

locals {
  alb_arn_suffix = module.alb.arn_suffix                              # e.g. app/eshop-alb/79dee...
  tg_arn_suffix  = module.alb.target_groups["ex-instance"].arn_suffix # e.g. targetgroup/app-xxx/yyy
  ecs_cluster    = module.ecs.cluster_name
  ecs_service    = "ecommerce-backend"
  alarm_actions  = [aws_sns_topic.alerts.arn]
}

# --- Notifications ----------------------------------------------------------

resource "aws_sns_topic" "alerts" {
  name = "ecommerce-backend-alerts"
}

# E-mail subscription is optional. After apply, AWS sends a confirmation mail: click the link,
# otherwise no alert is delivered. Leave var.alert_email empty to create the topic only.
resource "aws_sns_topic_subscription" "email" {
  count     = var.alert_email == "" ? 0 : 1
  topic_arn = aws_sns_topic.alerts.arn
  protocol  = "email"
  endpoint  = var.alert_email
}

# --- ALB alarms -------------------------------------------------------------

# Users get errors. Counts BOTH errors from your app (target 5xx, e.g. a Django 500) and errors
# generated by the ALB itself (502/503/504, e.g. when no healthy target exists).
resource "aws_cloudwatch_metric_alarm" "alb_5xx" {
  alarm_name          = "ecommerce-alb-5xx-errors"
  alarm_description   = "More than 5 server errors (app 5xx + ALB 5xx) in 5 minutes"
  comparison_operator = "GreaterThanThreshold"
  threshold           = 5
  evaluation_periods  = 1
  treat_missing_data  = "notBreaching" # no traffic = no errors
  alarm_actions       = local.alarm_actions

  metric_query {
    id          = "total_5xx"
    expression  = "target_5xx + elb_5xx"
    label       = "Total 5xx"
    return_data = true
  }

  metric_query {
    id = "target_5xx"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_Target_5XX_Count"
      period      = 300
      stat        = "Sum"
      dimensions  = { LoadBalancer = local.alb_arn_suffix }
    }
  }

  metric_query {
    id = "elb_5xx"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_ELB_5XX_Count"
      period      = 300
      stat        = "Sum"
      dimensions  = { LoadBalancer = local.alb_arn_suffix }
    }
  }
}

# Outage: no healthy container behind the ALB (this is what produced your 503 earlier).
resource "aws_cloudwatch_metric_alarm" "alb_no_healthy_hosts" {
  alarm_name          = "ecommerce-alb-no-healthy-hosts"
  alarm_description   = "No healthy targets behind the ALB for 2 minutes"
  namespace           = "AWS/ApplicationELB"
  metric_name         = "HealthyHostCount"
  dimensions          = { LoadBalancer = local.alb_arn_suffix, TargetGroup = local.tg_arn_suffix }
  statistic           = "Minimum"
  period              = 60
  evaluation_periods  = 2
  comparison_operator = "LessThanThreshold"
  threshold           = 1
  treat_missing_data  = "breaching" # no data usually means no targets at all
  alarm_actions       = local.alarm_actions
}

# Slow responses (p95 above 2 seconds for 10 minutes).
resource "aws_cloudwatch_metric_alarm" "alb_slow_responses" {
  alarm_name          = "ecommerce-alb-slow-responses"
  alarm_description   = "95th percentile response time above 2s for 10 minutes"
  namespace           = "AWS/ApplicationELB"
  metric_name         = "TargetResponseTime"
  dimensions          = { LoadBalancer = local.alb_arn_suffix }
  extended_statistic  = "p95"
  period              = 300
  evaluation_periods  = 2
  comparison_operator = "GreaterThanThreshold"
  threshold           = 2
  treat_missing_data  = "notBreaching"
  alarm_actions       = local.alarm_actions
}

# --- Log-based alarm (metric filter) -----------------------------------------
# Turns error lines in the application log into a metric, then alarms on it.
# This catches errors the ALB metrics cannot see, e.g. a container crashing at startup
# (such as "SECRET_KEY must not be empty") where no request ever reaches the app.

locals {
  # Log group created by the ECS module for the backend container (/aws/ecs/ecommerce-backend/backend-container)
  app_log_group = module.ecs.services["ecommerce-backend"].container_definitions["backend-container"].cloudwatch_log_group_name
}

resource "aws_cloudwatch_log_metric_filter" "app_errors" {
  name           = "ecommerce-backend-errors"
  log_group_name = local.app_log_group

  # Matches a Django 500 ("Internal Server Error: /api/...") OR any Python traceback.
  # A single error can match several lines; that is fine because the alarm uses a threshold.
  pattern = "?\"Internal Server Error\" ?\"Traceback\""

  metric_transformation {
    name          = "ApplicationErrorCount"
    namespace     = "Ecommerce/Backend"
    value         = "1"
    default_value = "0" # publish 0 when nothing matches, so the metric always has data
  }
}

resource "aws_cloudwatch_metric_alarm" "app_errors" {
  alarm_name          = "ecommerce-app-error-logs"
  alarm_description   = "3 or more error / traceback log lines in 5 minutes (see the dashboard's error table and the CloudWatch log group)"
  namespace           = "Ecommerce/Backend"
  metric_name         = aws_cloudwatch_log_metric_filter.app_errors.metric_transformation[0].name
  statistic           = "Sum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = 3 # raise it if single stray errors alert you too often
  treat_missing_data  = "notBreaching"
  alarm_actions       = local.alarm_actions
}

# --- ECS alarms -------------------------------------------------------------
# Fargate task is small (0.25 vCPU / 512 MB), so high usage is a realistic problem.

resource "aws_cloudwatch_metric_alarm" "ecs_cpu_high" {
  alarm_name          = "ecommerce-ecs-cpu-high"
  alarm_description   = "ECS service CPU above 80% for 10 minutes"
  namespace           = "AWS/ECS"
  metric_name         = "CPUUtilization"
  dimensions          = { ClusterName = local.ecs_cluster, ServiceName = local.ecs_service }
  statistic           = "Average"
  period              = 300
  evaluation_periods  = 2
  comparison_operator = "GreaterThanThreshold"
  threshold           = 80
  treat_missing_data  = "notBreaching"
  alarm_actions       = local.alarm_actions
}

# Memory near the limit means the kernel kills the container (exit code 137).
resource "aws_cloudwatch_metric_alarm" "ecs_memory_high" {
  alarm_name          = "ecommerce-ecs-memory-high"
  alarm_description   = "ECS service memory above 80% for 10 minutes"
  namespace           = "AWS/ECS"
  metric_name         = "MemoryUtilization"
  dimensions          = { ClusterName = local.ecs_cluster, ServiceName = local.ecs_service }
  statistic           = "Average"
  period              = 300
  evaluation_periods  = 2
  comparison_operator = "GreaterThanThreshold"
  threshold           = 80
  treat_missing_data  = "notBreaching"
  alarm_actions       = local.alarm_actions
}

# --- Dashboard --------------------------------------------------------------

resource "aws_cloudwatch_dashboard" "backend" {
  dashboard_name = "ecommerce-backend"

  dashboard_body = jsonencode({
    widgets = [
      {
        type = "metric", x = 0, y = 0, width = 12, height = 6
        properties = {
          title  = "ALB requests and 5xx errors"
          region = data.aws_region.current.region
          stat   = "Sum"
          period = 60
          metrics = [
            ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", local.alb_arn_suffix, { label = "Requests" }],
            [".", "HTTPCode_Target_5XX_Count", ".", ".", { label = "App 5xx (Django)" }],
            [".", "HTTPCode_ELB_5XX_Count", ".", ".", { label = "ALB 5xx (502/503/504)" }],
            [".", "HTTPCode_Target_4XX_Count", ".", ".", { label = "App 4xx" }],
          ]
        }
      },
      {
        type = "metric", x = 12, y = 0, width = 12, height = 6
        properties = {
          title  = "ALB response time (seconds)"
          region = data.aws_region.current.region
          period = 60
          metrics = [
            ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", local.alb_arn_suffix, { stat = "p50", label = "p50" }],
            ["...", { stat = "p95", label = "p95" }],
          ]
        }
      },
      {
        type = "metric", x = 0, y = 6, width = 8, height = 6
        properties = {
          title  = "Healthy / unhealthy targets"
          region = data.aws_region.current.region
          stat   = "Maximum"
          period = 60
          metrics = [
            ["AWS/ApplicationELB", "HealthyHostCount", "LoadBalancer", local.alb_arn_suffix, "TargetGroup", local.tg_arn_suffix, { label = "Healthy" }],
            [".", "UnHealthyHostCount", ".", ".", ".", ".", { label = "Unhealthy" }],
          ]
        }
      },
      {
        type = "metric", x = 8, y = 6, width = 8, height = 6
        properties = {
          title  = "ECS CPU (%)"
          region = data.aws_region.current.region
          stat   = "Average"
          period = 60
          yAxis  = { left = { min = 0, max = 100 } }
          metrics = [
            ["AWS/ECS", "CPUUtilization", "ClusterName", local.ecs_cluster, "ServiceName", local.ecs_service],
          ]
          annotations = { horizontal = [{ label = "Alarm", value = 80 }] }
        }
      },
      {
        type = "metric", x = 16, y = 6, width = 8, height = 6
        properties = {
          title  = "ECS memory (%)"
          region = data.aws_region.current.region
          stat   = "Average"
          period = 60
          yAxis  = { left = { min = 0, max = 100 } }
          metrics = [
            ["AWS/ECS", "MemoryUtilization", "ClusterName", local.ecs_cluster, "ServiceName", local.ecs_service],
          ]
          annotations = { horizontal = [{ label = "Alarm", value = 80 }] }
        }
      },
      {
        type = "log", x = 0, y = 12, width = 24, height = 6
        properties = {
          title  = "Recent backend errors"
          region = data.aws_region.current.region
          view   = "table"
          query  = "SOURCE '/aws/ecs/ecommerce-backend/backend-container' | fields @timestamp, @message | filter @message like /Error|Exception/ | sort @timestamp desc | limit 20"
        }
      },
    ]
  })
}
