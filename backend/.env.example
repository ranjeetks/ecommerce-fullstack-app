# --- Required: the app will not start without this ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# --- Required in deployment (defaults are dev-only or insecure) ---
# ENV: DEV or PROD (PROD enables secure cookies)
ENV=DEV
# DEBUG: must be False or unset in production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database. If unset, falls back to a local SQLite file (data is lost in containers).
# DATABASE_URL=postgres://user:password@host:5432/dbname
